# Versiroom — Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos clés API

# OpenAI (prioritaire) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Replicate (fallback) — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# PostgreSQL — logs de generation (Replit fournit cette variable automatiquement)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Replit Object Storage — stockage images (automatique sur Replit)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=...

# Admin — mot de passe page /admin
ADMIN_PASSWORD=...

# Internal API Secret — securise les appels batch F4 Mode Marchand
# Generez avec: openssl rand -hex 32
INTERNAL_API_SECRET=...

# Base URL (optionnel — defaut: https://architecture-toum92.replit.app)
# NEXT_PUBLIC_BASE_URL=https://versiroom.fr

# NextAuth — https://next-auth.js.org/configuration/options
NEXTAUTH_SECRET=...
NEXTAUTH_URL=https://architecture-toum92.replit.app

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sentry — https://sentry.io (free tier 5K events/month)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ORG=your-org
# SENTRY_PROJECT=versiroom
