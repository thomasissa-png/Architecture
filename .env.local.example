# VisiRénov — Variables d'environnement
# Copiez ce fichier en .env.local et renseignez vos clés API

# OpenAI (prioritaire) — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Replicate (fallback) — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# PostgreSQL — logs de generation (Replit fournit cette variable automatiquement)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Replit Object Storage — stockage images (automatique sur Replit)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=...

# Admin — mot de passe page /admin
ADMIN_PASSWORD=...

# Base URL (optionnel — defaut: https://architecture-toum92.replit.app)
# NEXT_PUBLIC_BASE_URL=https://visirenov.fr
